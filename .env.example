# Copy to .env only if you want optional features. The core app needs NONE of these.
# Never commit a real .env file.

# Optional: rephrase brief wording with an LLM (never computes numbers). Off by default.
ENABLE_LLM_REPHRASE=0

# Optional (Level 9 stretch): grounded "ask the data" box. Off by default.
ENABLE_LLM_ASK=0

# Only needed if one of the optional features above is turned on.
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
